/* ==================== WATCHLIST ==================== */
async function renderWatchlist(){
  await fetchQuote(S.watchlist);
  const div=document.getElementById('watchlist-container');
  if(!S.watchlist.length){div.innerHTML='<div class="text-xs text-muted text-center py-8">Your watchlist is empty. Add stocks from search.</div>';return;}
  div.innerHTML=S.watchlist.map(s=>{
    const q=S.quoteCache[s]||{};const up=(q.changePct||0)>=0;
    return `<div onclick="openStock('${s}')" class="flex items-center justify-between bg-card border border-bdr rounded-xl p-3 cursor-pointer active:bg-cardhv transition-colors">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-lg ${up?'bg-grn/10':'bg-red/10'} flex items-center justify-center">
          <span class="text-xs font-bold ${up?'text-grn':'text-red'}">${s.slice(0,2)}</span>
        </div>
        <div><div class="text-sm font-semibold">${s}</div><div class="text-[10px] text-muted truncate max-w-[150px]">${q.name||''}</div></div>
      </div>
      <div class="flex items-center gap-3">
        <div class="text-right"><div class="mono text-sm font-semibold">${formatNum(q.price)}</div><div class="mono text-[11px] ${up?'text-grn':'text-red'}">${up?'+':''}${formatNum(q.changePct,2)}%</div></div>
        <button onclick="event.stopPropagation();removeWatchlist('${s}')" class="text-muted text-xs w-7 h-7 rounded-lg bg-bg border border-bdr flex items-center justify-center"><i class="fas fa-times text-[9px]"></i></button>
      </div>
    </div>`;
  }).join('');
}

function removeWatchlist(s){S.watchlist=S.watchlist.filter(w=>w!==s);saveState();renderWatchlist();showToast(`${s} removed from watchlist`);}
function showAddWatchlist(){
  navigate('search');
  setTimeout(()=>document.getElementById('search-input').focus(),100);
}

/* ==================== PORTFOLIO ==================== */
function renderPortfolio(){
  let totalValue=S.cash;let totalPnL=0;
  const holdingsArr=Object.entries(S.holdings).map(([sym,h])=>{
    const q=S.quoteCache[sym]||{};
    const curPrice=q.price||h.avgPrice;
    const val=curPrice*h.qty;totalValue+=val;
    const pnl=(curPrice-h.avgPrice)*h.qty;totalPnL+=pnl;
    const pnlPct=h.avgPrice?pnl/(h.avgPrice*h.qty)*100:0;
    return {symbol:sym,...h,curPrice,val,pnl,pnlPct};
  });
  const sumDiv=document.getElementById('portfolio-summary');
  const up=totalPnL>=0;
  sumDiv.innerHTML=`
    <div class="grid grid-cols-2 gap-3">
      <div><div class="text-[10px] text-muted">Total Value</div><div class="mono text-lg font-bold text-amb">$${formatNum(totalValue)}</div></div>
      <div><div class="text-[10px] text-muted">Available Cash</div><div class="mono text-lg font-bold">$${formatNum(S.cash)}</div></div>
      <div><div class="text-[10px] text-muted">Total P&L</div><div class="mono text-lg font-bold ${up?'text-grn':'text-red'}">${up?'+':''}$${formatNum(totalPnL)}</div></div>
      <div><div class="text-[10px] text-muted">Return</div><div class="mono text-lg font-bold ${up?'text-grn':'text-red'}">${up?'+':''}${totalValue>CFG.INIT_CASH?((totalValue-CFG.INIT_CASH)/CFG.INIT_CASH*100).toFixed(2):'0.00'}%</div></div>
    </div>
    <div class="mt-3 pt-3 border-t border-bdr flex gap-2">
      <button onclick="resetPortfolio()" class="flex-1 text-[10px] py-2 rounded-lg bg-red/10 border border-red/20 text-red">Reset Account</button>
    </div>`;

  const hDiv=document.getElementById('holdings-list');
  if(!holdingsArr.length) hDiv.innerHTML='<div class="text-xs text-muted text-center py-6">No holdings yet. Start trading!</div>';
  else hDiv.innerHTML=holdingsArr.map(h=>{
    const up=h.pnl>=0;
    return `<div onclick="openStock('${h.symbol}')" class="bg-card border border-bdr rounded-xl p-3 cursor-pointer active:bg-cardhv transition-colors">
      <div class="flex items-center justify-between mb-2">
        <div><span class="text-sm font-semibold">${h.symbol}</span><span class="text-[10px] text-muted ml-2">${h.qty} shares</span></div>
        <div class="text-right"><div class="mono text-sm font-semibold">$${formatNum(h.val)}</div><div class="mono text-[10px] ${up?'text-grn':'text-red'}">${up?'+':''}$${formatNum(h.pnl)} (${up?'+':''}${formatNum(h.pnlPct,1)}%)</div></div>
      </div>
      <div class="flex justify-between text-[9px] text-muted"><span>Avg: $${formatNum(h.avgPrice)}</span><span>Current: $${formatNum(h.curPrice)}</span></div>
    </div>`;
  }).join('');

  const histDiv=document.getElementById('history-list');
  if(!S.history.length) histDiv.innerHTML='<div class="text-xs text-muted text-center py-6">No trade history</div>';
  else histDiv.innerHTML=S.history.slice(-20).reverse().map(h=>{
    const isBuy=h.type==='buy';
    return `<div class="bg-card border border-bdr rounded-xl p-3">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2"><span class="text-[10px] px-2 py-0.5 rounded-full font-bold ${isBuy?'bg-grn/15 text-grn':'bg-red/15 text-red'}">${h.type.toUpperCase()}</span><span class="text-sm font-semibold">${h.symbol}</span></div>
        <div class="text-right"><div class="mono text-xs">${h.qty} @ $${formatNum(h.price)}</div><div class="mono text-[10px] text-amb">Total: $${formatNum(h.total)}</div></div>
      </div>
      <div class="text-[9px] text-muted mt-1">${new Date(h.time).toLocaleString()}</div>
    </div>`;
  }).join('');
}

function resetPortfolio(){
  if(!confirm('Reset demo account to $100,000?')) return;
  S.cash=CFG.INIT_CASH;S.holdings={};S.history=[];saveState();renderPortfolio();updateBalance();showToast('Account reset to $100,000','info');
}

/* ==================== TRADING ==================== */
function openTrade(type){
  S.tradeType=type;
  const modal=document.getElementById('trade-modal');
  modal.style.display='flex';
  const badge=document.getElementById('trade-type-badge');
  const btn=document.getElementById('trade-confirm-btn');
  if(type==='buy'){
    badge.className='px-3 py-1 rounded-lg text-xs font-bold bg-grn/20 text-grn';badge.textContent='BUY';
    btn.className='w-full py-3.5 rounded-xl text-sm font-bold text-bg btn-buy';btn.textContent='Confirm Buy';
  } else {
    badge.className='px-3 py-1 rounded-lg text-xs font-bold bg-red/20 text-red';badge.textContent='SELL';
    btn.className='w-full py-3.5 rounded-xl text-sm font-bold text-white btn-sell';btn.textContent='Confirm Sell';
  }
  document.getElementById('trade-qty').value=1;
  updateTradeTotal();
}

function closeTrade(){document.getElementById('trade-modal').style.display='none';}

function adjustQty(d){const inp=document.getElementById('trade-qty');inp.value=Math.max(1,parseInt(inp.value||1)+d);updateTradeTotal();}

function setQtyPct(pct){
  if(!S.symbol) return;
  const q=S.quoteCache[S.symbol];if(!q||!q.price) return;
  if(S.tradeType==='buy'){
    const maxQty=Math.floor(S.cash*pct/100/q.price);
    document.getElementById('trade-qty').value=Math.max(1,maxQty);
  } else {
    const h=S.holdings[S.symbol];
    document.getElementById('trade-qty').value=h?Math.max(1,Math.floor(h.qty*pct/100)):1;
  }
  updateTradeTotal();
}

function updateTradeTotal(){
  const q=S.quoteCache[S.symbol];if(!q||!q.price) return;
  const qty=parseInt(document.getElementById('trade-qty').value)||1;
  const total=qty*q.price;
  document.getElementById('trade-price').textContent='$'+formatNum(q.price);
  document.getElementById('trade-qty-display').textContent=qty+' shares';
  document.getElementById('trade-total').textContent='$'+formatNum(total);
}

function executeTrade(){
  const q=S.quoteCache[S.symbol];if(!q||!q.price) return;
  const qty=parseInt(document.getElementById('trade-qty').value)||1;
  const price=q.price;const total=qty*price;

  if(S.tradeType==='buy'){
    if(total>S.cash){showToast('Insufficient funds for this trade','sell');return;}
    S.cash-=total;
    if(!S.holdings[S.symbol]) S.holdings[S.symbol]={qty:0,avgPrice:0,totalCost:0};
    const h=S.holdings[S.symbol];
    h.totalCost+=total;h.qty+=qty;h.avgPrice=h.totalCost/h.qty;
    S.history.push({type:'buy',symbol:S.symbol,qty,price,total,time:Date.now()});
    showToast(`Bought ${qty} ${S.symbol} @ $${formatNum(price)}`,'buy');
  } else {
    const h=S.holdings[S.symbol];
    if(!h||h.qty<qty){showToast(`Insufficient shares. You have ${h?h.qty:0} ${S.symbol}`,'sell');return;}
    S.cash+=total;h.qty-=qty;h.totalCost=h.avgPrice*h.qty;
    if(h.qty===0) delete S.holdings[S.symbol];
    S.history.push({type:'sell',symbol:S.symbol,qty,price,total,time:Date.now()});
    showToast(`Sold ${qty} ${S.symbol} @ $${formatNum(price)}`,'sell');
  }
  saveState();updateBalance();closeTrade();
  if(S.view==='portfolio') renderPortfolio();
}

function updateBalance(){document.getElementById('header-balance').textContent='$'+formatNum(S.cash);}

/* ==================== NAVIGATION ==================== */
document.querySelectorAll('.nav-btn').forEach(btn=>{
  btn.addEventListener('click',()=>navigate(btn.dataset.view));
});

