@keyframes toastIn{from{transform:translateX(100%);opacity:0}to{transform:translateX(0);opacity:1}}
@keyframes toastOut{from{opacity:1}to{opacity:0;transform:translateY(-20px)}}
.indicator-card{background:linear-gradient(135deg,#111827 0%,#0f1724 100%);border:1px solid #1e2a3a;border-radius:10px;padding:10px 12px}
.signal-buy{background:linear-gradient(135deg,rgba(0,230,118,.12),rgba(0,230,118,.03));border:1px solid rgba(0,230,118,.3)}
