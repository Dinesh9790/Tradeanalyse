/* ==================== STOCK DETAIL ==================== */
async function openStock(symbol){
  S.symbol=symbol;navigate('stock');
  document.getElementById('stock-symbol').textContent=symbol;
  document.getElementById('stock-name').textContent=S.quoteCache[symbol]?.name||symbol;
  document.getElementById('trade-symbol').textContent=symbol;
  await loadStockData();
}

async function loadStockData(){
  if(!S.symbol) return;
  const data=await fetchChartData(S.symbol, S.intv);
  S.candles=data;
  S.indicators=TA.runAll(data);
  const rec=generateRecommendation(data, S.indicators);
  S.recommendation=rec;
  // Update header
  const last=data[data.length-1];
  const prev=data[data.length-2]||last;
  const chg=last.close-prev.close;const chgPct=prev.close?chg/prev.close*100:0;
  const up=chg>=0;
  document.getElementById('stock-price').textContent='$'+formatNum(last.close);
  document.getElementById('stock-price').className=`text-xl font-bold mono ${up?'text-grn':'text-red'}`;
  document.getElementById('stock-change').innerHTML=`<span class="${up?'text-grn':'text-red'}">${up?'+':''}${formatNum(chg)} (${up?'+':''}${formatNum(chgPct,2)}%)</span>`;
  document.getElementById('trade-price-label').textContent='$'+formatNum(last.close)+' per share';
  // Update chart
  if(!chart) chart=new Chart('stock-chart');
  chart.showSMA=document.getElementById('tog-sma').checked;
  chart.showBB=document.getElementById('tog-bb').checked;
  chart.showVol=document.getElementById('tog-vol').checked;
  chart.showRSI=document.getElementById('tog-rsi').checked;
  chart.setData(data, S.indicators);
  // Analysis
  renderAnalysis(rec, data);
}

function renderAnalysis(rec, data){
  const n=data.length;const last=data[n-1];
  const isBuy=rec.signal.includes('BUY');const isSell=rec.signal.includes('SELL');
  const sigClass=isBuy?'signal-buy':isSell?'signal-sell':'signal-hold';
  const sigColor=isBuy?'text-grn':isSell?'text-red':'text-amb';
  const ind=S.indicators;
  const div=document.getElementById('stock-analysis');

  // Support/Resistance
  const sr=ind.sr;
  const srHTML=sr.supports.length||sr.resistances.length?`<div class="indicator-card"><div class="text-[11px] font-semibold mb-2">Support & Resistance</div>
    ${sr.resistances.map((r,i)=>`<div class="flex justify-between text-[10px] mb-1"><span class="text-red">R${i+1}</span><span class="mono text-red">${formatNum(r)}</span></div>`).join('')}
    <div class="flex justify-between text-[10px] my-1 border-t border-bdr pt-1"><span class="text-muted">Price</span><span class="mono text-amb">${formatNum(rec.price)}</span></div>
    ${sr.supports.map((r,i)=>`<div class="flex justify-between text-[10px] mb-1"><span class="text-grn">S${i+1}</span><span class="mono text-grn">${formatNum(r)}</span></div>`).join('')}
  </div>`:'';

  // Patterns
  const patHTML=ind.patterns.length?`<div class="indicator-card"><div class="text-[11px] font-semibold mb-2">Detected Patterns</div>
    ${ind.patterns.map(p=>`<div class="flex items-center justify-between mb-1.5"><div><span class="text-[11px] font-semibold">${p.name}</span><span class="text-[9px] text-muted ml-2">${p.desc}</span></div><span class="text-[9px] px-1.5 py-0.5 rounded ${p.type==='bullish'?'bg-grn/15 text-grn':p.type==='bearish'?'bg-red/15 text-red':'bg-amb/15 text-amb'}">${p.type.toUpperCase()}</span></div>`).join('')}
  </div>`:'<div class="indicator-card"><div class="text-[11px] font-semibold mb-2">Detected Patterns</div><div class="text-[10px] text-muted">No significant patterns detected</div></div>';

  // News simulation
  const news=generateNews(S.symbol, rec, last);
  const newsHTML=`<div class="indicator-card"><div class="text-[11px] font-semibold mb-2">Related Analysis</div>
    ${news.map(n=>`<div class="mb-2 pb-2 border-b border-bdr last:border-0"><div class="text-[11px] font-medium leading-tight">${n.title}</div><div class="text-[9px] text-muted mt-1">${n.time} · ${n.source}</div></div>`).join('')}
  </div>`;

  // Investment suggestion
  const riskPct=rec.atr/last.close*100;
  const sugPos=Math.min(S.cash*0.05/(riskPct*last.close||1), Math.floor(S.cash/last.close));
  const sugHTML=`<div class="indicator-card"><div class="text-[11px] font-semibold mb-2">Investment Suggestion</div>
    <div class="space-y-1.5 text-[10px]">
      <div class="flex justify-between"><span class="text-muted">Risk per trade (2%)</span><span class="mono text-amb">$${formatNum(S.cash*0.02,0)}</span></div>
      <div class="flex justify-between"><span class="text-muted">ATR (volatility)</span><span class="mono">${formatNum(rec.atr)} (${riskPct.toFixed(2)}%)</span></div>
      <div class="flex justify-between"><span class="text-muted">Suggested max qty</span><span class="mono text-grn">${Math.max(1,Math.floor(sugPos))} shares</span></div>
      <div class="flex justify-between"><span class="text-muted">Suggested position size</span><span class="mono">$${formatNum(Math.max(1,Math.floor(sugPos))*last.close,0)}</span></div>
      <div class="flex justify-between"><span class="text-muted">Stop loss (2x ATR)</span><span class="mono text-red">$${formatNum(last.close-rec.atr*2)}</span></div>
      <div class="flex justify-between"><span class="text-muted">Take profit (3x ATR)</span><span class="mono text-grn">$${formatNum(last.close+rec.atr*3)}</span></div>
    </div>
  </div>`;

  div.innerHTML=`
    <div class="${sigClass} rounded-xl p-4 fade-in">
      <div class="flex items-center justify-between mb-2">
        <span class="text-2xl font-bold ${sigColor}">${rec.signal}</span>
        <div class="text-right"><div class="text-[10px] text-muted">Confidence</div><div class="mono text-lg font-bold ${sigColor}">${rec.confidence}%</div></div>
      </div>
      <div class="w-full h-2 rounded-full bg-bg overflow-hidden"><div class="h-full rounded-full transition-all duration-500 ${isBuy?'bg-grn':isSell?'bg-red':'bg-amb'}" style="width:${rec.confidence}%"></div></div>
      <div class="text-[10px] text-muted mt-2">Composite score: ${rec.score.toFixed(3)} from ${rec.details.length} indicators</div>
    </div>

    <div class="indicator-card fade-in">
      <div class="text-[11px] font-semibold mb-3">Next 5-Minute Prediction</div>
      <div class="space-y-2">
        <div><div class="flex justify-between text-[10px] mb-1"><span class="text-grn"><i class="fas fa-arrow-up mr-1"></i>Bullish</span><span class="mono text-grn">${rec.pred5m.up}%</span></div><div class="prob-bar"><div class="prob-fill bg-grn" style="width:${rec.pred5m.up}%"></div></div></div>
        <div><div class="flex justify-between text-[10px] mb-1"><span class="text-muted"><i class="fas fa-arrows-left-right mr-1"></i>Sideways</span><span class="mono text-muted">${rec.pred5m.sideways}%</span></div><div class="prob-bar"><div class="prob-fill bg-muted" style="width:${rec.pred5m.sideways}%"></div></div></div>
        <div><div class="flex justify-between text-[10px] mb-1"><span class="text-red"><i class="fas fa-arrow-down mr-1"></i>Bearish</span><span class="mono text-red">${rec.pred5m.down}%</span></div><div class="prob-bar"><div class="prob-fill bg-red" style="width:${rec.pred5m.down}%"></div></div></div>
      </div>
    </div>

    <div class="grid grid-cols-2 gap-2">
      ${rec.details.map(d=>`<div class="indicator-card"><div class="text-[9px] text-muted">${d.ind}</div><div class="mono text-xs font-semibold" style="color:${colorMap[d.color]||'#e8edf5'}">${d.val}</div><div class="text-[9px]" style="color:${colorMap[d.color]||'#6b7a8d'}">${d.sig}</div></div>`).join('')}
    </div>

    ${srHTML}
    ${patHTML}
    ${sugHTML}
    ${newsHTML}
  `;
}

function generateNews(symbol, rec, last){
  const names={'AAPL':'Apple','GOOGL':'Alphabet','MSFT':'Microsoft','TSLA':'Tesla','AMZN':'Amazon','NVDA':'NVIDIA','META':'Meta','JPM':'JPMorgan','NFLX':'Netflix','DIS':'Disney'};
  const name=names[symbol]||symbol;
  const isUp=rec.score>0.1;const isDown=rec.score<-0.1;
  const news=[];
  if(isUp){
    news.push({title:`${name} shows strong momentum as technical indicators turn bullish`,time:'2m ago',source:'MarketWatch'});
    news.push({title:`Institutional activity detected in ${name} - volume spike suggests accumulation`,time:'15m ago',source:'Bloomberg'});
    if(rec.pred5m.up>45) news.push({title:`Short-term model projects continued upside for ${name} in next session`,time:'28m ago',source:'Reuters'});
  } else if(isDown){
    news.push({title:`${name} faces selling pressure as bearish signals emerge from multiple indicators`,time:'5m ago',source:'MarketWatch'});
    news.push({title:`Risk-off sentiment impacts ${name} as traders reduce exposure`,time:'18m ago',source:'Bloomberg'});
    if(rec.pred5m.down>45) news.push({title:`Technical breakdown in ${name} may trigger further downside`,time:'32m ago',source:'Reuters'});
  } else {
    news.push({title:`${name} consolidates in tight range awaiting next catalyst`,time:'10m ago',source:'MarketWatch'});
    news.push({title:`Mixed signals for ${name} as market weighs competing factors`,time:'25m ago',source:'Bloomberg'});
  }
  news.push({title:`Global market conditions: Fed policy outlook remains key driver for tech stocks`,time:'45m ago',source:'CNBC'});
  news.push({title:`Sector analysis: ${name}'s sector shows ${isUp?'relative strength':'weakness'} vs broader market`,time:'1h ago',source:'Financial Times'});
  return news;
}

